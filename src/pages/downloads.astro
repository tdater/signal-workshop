---
import Base from '../layouts/Base.astro';
import DownloadPassport from '../components/DownloadPassport.astro';
import {
  getProjects,
  getReleases,
  getGuides,
  editionName,
  formatDate,
  formatBytes,
  channelLabel,
} from '../lib/content';

const projects = await getProjects();
const releases = await getReleases();
const guides = await getGuides();
---

<Base
  title="Downloads"
  current="/downloads"
  description="Current APK releases of KITT Launcher, KITT Launcher.2, RetroTV and BLACKBOX with file sizes, SHA-256 checksums, QR codes and install steps."
>
  <div class="wrap section">
    <p class="eyebrow">Downloads</p>
    <h1>Downloads</h1>
    <p class="lede">
      Current releases first. Every button downloads the published APK directly from its GitHub
      release. You don't need to sign in, and there are no countdown pages or ad redirects.
    </p>
    <div class="callout">
      <p class="callout__title">Before you install</p>
      <p>
        These apps aren't on the Play Store. Android will ask you to allow your browser or file
        manager to install apps. See{' '}
        <a href="/guides/installing-android-apps">installing apps from this site</a> for what that
        permission does and what 2026's developer verification changes. A SHA-256 checksum proves a
        file matches the published one. It doesn't prove the app is safe or that it works on your
        device.
      </p>
    </div>

    {projects.map((p) => {
      const rel = releases.filter((r) => r.project === p.slug);
      const current = rel.filter((r) => r.current);
      const prev = rel.filter((r) => !r.current);
      const install = guides.find(
        (g) => g.project === p.slug && g.slug.startsWith('install-'),
      )?.slug;
      return (
        <section
          class="dl"
          id={p.slug}
          style={`--accent:${p.accent}`}
          aria-labelledby={`${p.slug}-h`}
        >
          <div class="dl__head">
            <h2 id={`${p.slug}-h`}>{p.title}</h2>
            <a href={`/projects/${p.slug}`}>About {p.title}</a>
          </div>
          <p class="hint">{p.stateNote}</p>
          {current.length === 0 ? (
            <div class="panel">
              <p>No release is available for {p.title} right now.</p>
            </div>
          ) : (
            <div class="dl__grid">
              {current.map((r) => (
                <DownloadPassport release={r} project={p} installGuide={install} />
              ))}
            </div>
          )}
          {prev.length > 0 && (
            <details class="dl__prev">
              <summary>Previous versions of {p.title}</summary>
              <p class="hint">
                Older builds are kept for reference. Each checksum is the SHA-256 digest GitHub
                computed for that published file.
              </p>
              <div
                class="table-scroll"
                tabindex="0"
                role="region"
                aria-label={`Previous ${p.title} versions`}
              >
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Version</th>
                      <th scope="col">Date</th>
                      <th scope="col">Size</th>
                      <th scope="col">SHA-256</th>
                      <th scope="col">File</th>
                    </tr>
                  </thead>
                  <tbody>
                    {prev.map((r) => (
                      <tr id={`passport-${r.id}`}>
                        <th scope="row">
                          {editionName(p, r.edition)} v{r.version}{' '}
                          <span class="badge badge--muted">{channelLabel[r.channel]}</span>
                        </th>
                        <td>{formatDate(r.date)}</td>
                        <td>{r.artifact ? formatBytes(r.artifact.bytes) : '—'}</td>
                        <td>
                          <code class="sha">{r.artifact?.sha256}</code>
                        </td>
                        <td>
                          {r.artifact ? (
                            <a href={r.artifact.url}>{r.artifact.filename}</a>
                          ) : (
                            'Unavailable'
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
        </section>
      );
    })}
  </div>
</Base>

<style>
  .dl {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .dl__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: baseline;
  }
  .dl__head h2 {
    margin: 0;
  }
  .dl__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    margin-top: var(--space-4);
  }
  .dl__prev {
    margin-top: var(--space-5);
  }
  .dl__prev summary {
    cursor: pointer;
    font-weight: 700;
    min-height: var(--target);
    display: flex;
    align-items: center;
  }
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: var(--step--1);
  }
  th,
  td {
    text-align: left;
    padding: var(--space-3);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .sha {
    font-size: 0.75rem;
    word-break: break-all;
    display: inline-block;
    min-width: 14rem;
  }
  tr:target {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
</style>

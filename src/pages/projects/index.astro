---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getReleases, currentReleases, stateLabel } from '../../lib/content';

const projects = await getProjects();
const releases = await getReleases();
const platforms = [...new Set(projects.flatMap((p) => p.platforms))].sort();
const states = [...new Set(projects.map((p) => p.state))];
const categories = [...new Set(projects.flatMap((p) => p.category))].sort();
---

<Base
  title="Projects"
  current="/projects"
  description="Browse, search and filter Travis Dater's Android projects by platform, category and status."
>
  <div class="wrap section">
    <p class="eyebrow">Project library</p>
    <h1>Projects</h1>
    <p class="lede">
      {projects.length} published projects. Filter by what you've got or what you're into. Nothing
      here is a mock-up: if it's listed, it exists, and its status says how finished it is.
    </p>

    <form class="filters" data-filters hidden>
      <div class="field filters__search">
        <label for="lib-q">Search projects</label>
        <input
          id="lib-q"
          type="search"
          placeholder="e.g. OBD, controller, offline"
          autocomplete="off"
        />
      </div>
      <fieldset>
        <legend>Platform</legend>
        <ul class="chips">
          {platforms.map((p) => (
            <li>
              <button
                type="button"
                class="chip"
                aria-pressed="false"
                data-kind="platform"
                data-value={p}
              >
                {p}
              </button>
            </li>
          ))}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Category</legend>
        <ul class="chips">
          {categories.map((c) => (
            <li>
              <button
                type="button"
                class="chip"
                aria-pressed="false"
                data-kind="category"
                data-value={c.toLowerCase()}
              >
                {c}
              </button>
            </li>
          ))}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Status</legend>
        <ul class="chips">
          {states.map((s) => (
            <li>
              <button
                type="button"
                class="chip"
                aria-pressed="false"
                data-kind="state"
                data-value={s}
              >
                {stateLabel[s]}
              </button>
            </li>
          ))}
        </ul>
      </fieldset>
    </form>
    <p class="mono hint" aria-live="polite" data-count></p>

    <div class="grid-cards" data-cards>
      {projects.map((p) => (
        <ProjectCard project={p} current={currentReleases(releases, p.slug)} headingLevel="h2" />
      ))}
    </div>
    <div class="panel" data-empty hidden>
      <p>
        <strong>No projects match those filters.</strong>
      </p>
      <p>
        Clear a filter or two, or <a href="/feedback?type=idea">suggest something to build</a>.
      </p>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  if (form) {
    form.hidden = false;
    form.addEventListener('submit', (e) => e.preventDefault());
    const cards = [...document.querySelectorAll<HTMLElement>('[data-cards] .pcard')];
    const q = form.querySelector<HTMLInputElement>('#lib-q')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('.chip')];
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const params = new URLSearchParams(location.search);
    if (params.get('q')) q.value = params.get('q')!;
    const apply = () => {
      const active = (kind: string) =>
        chips
          .filter((c) => c.dataset.kind === kind && c.getAttribute('aria-pressed') === 'true')
          .map((c) => c.dataset.value!);
      const plat = active('platform');
      const cat = active('category');
      const st = active('state');
      const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const ok =
          (!plat.length || plat.some((p) => card.dataset.platforms!.split('|').includes(p))) &&
          (!cat.length || cat.some((c) => card.dataset.search!.includes(c))) &&
          (!st.length || st.includes(card.dataset.state!)) &&
          terms.every((t) => card.dataset.search!.includes(t));
        card.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = `${shown} of ${cards.length} projects shown`;
      empty.hidden = shown > 0;
    };
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
        apply();
      }),
    );
    q.addEventListener('input', apply);
    apply();
  }
</script>

<style>
  .filters {
    margin: var(--space-5) 0 var(--space-3);
    display: grid;
    gap: var(--space-2);
  }
  .filters fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-3);
  }
  .filters legend {
    font: 600 var(--step--1) var(--font-mono);
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }
  .filters__search {
    max-width: 30rem;
    margin-bottom: var(--space-3);
  }
</style>

---
import Base from '../../layouts/Base.astro';
import FeedbackList from '../../components/FeedbackList.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { getProjects } from '../../lib/content';
import { LIMITS, FEEDBACK_TYPES } from '../../../functions/_lib/rules';

const projects = await getProjects();
---

<Base
  title="Feedback"
  current="/feedback"
  description="Send a comment, suggestion, idea, question or bug report about Travis Dater's projects or this website."
>
  <div class="wrap fb section">
    <div class="fb__main">
      <p class="eyebrow">Feedback</p>
      <h1>Tell me what you think</h1>
      <p class="lede">
        Comments, suggestions, ideas, questions and bug reports are all welcome, including the
        critical ones. You don't need an account.
      </p>
      <Disclaimer />

      <form class="fbform" method="post" action="/api/feedback" novalidate data-feedback-form>
        <div class="fbform__summary" role="alert" tabindex="-1" hidden data-error-summary></div>

        <fieldset>
          <legend>What kind of feedback?</legend>
          <div class="radio-row">
            {FEEDBACK_TYPES.map((t, i) => (
              <label>
                <input type="radio" name="type" value={t.id} checked={i === 0} required /> {t.label}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="field">
          <label for="fb-project">About</label>
          <select id="fb-project" name="project" required>
            <option value="site">This website</option>
            {projects.map((p) => (
              <option value={p.slug}>{p.title}</option>
            ))}
          </select>
        </div>

        <fieldset>
          <legend>Who can see it?</legend>
          <div class="radio-row radio-row--stack">
            <label>
              <input type="radio" name="visibility" value="public" checked /> Public: may appear on
              this site after review
            </label>
            <label>
              <input type="radio" name="visibility" value="private" /> Private report: only Travis
              sees it, and it's never published
            </label>
          </div>
        </fieldset>

        <div class="field">
          <label for="fb-title">
            Title <span class="hint">(optional)</span>
          </label>
          <input
            id="fb-title"
            name="title"
            type="text"
            maxlength={LIMITS.title}
            autocomplete="off"
          />
        </div>

        <div class="field">
          <label for="fb-message">Message</label>
          <textarea
            id="fb-message"
            name="message"
            required
            minlength={LIMITS.messageMin}
            maxlength={LIMITS.message}
            aria-describedby="fb-message-hint"
          ></textarea>
          <p class="hint" id="fb-message-hint">
            Plain text, {LIMITS.messageMin} to {LIMITS.message.toLocaleString('en-US')} characters.
            Please don't include passwords, API keys, licence keys, unredacted logs, VINs or other
            vehicle and device identifiers.
          </p>
        </div>

        <fieldset class="fbform__bug" data-bug-fields>
          <legend>
            Bug details <span class="hint">(for bug reports, all optional)</span>
          </legend>
          <div class="fbform__two">
            <div class="field">
              <label for="fb-version">App version</label>
              <input
                id="fb-version"
                name="appVersion"
                type="text"
                maxlength={LIMITS.short}
                placeholder="e.g. 1.8"
              />
            </div>
            <div class="field">
              <label for="fb-device">Device and Android version</label>
              <input
                id="fb-device"
                name="device"
                type="text"
                maxlength={LIMITS.short}
                placeholder='e.g. 10" head unit, Android 12'
              />
            </div>
          </div>
          <div class="field">
            <label for="fb-expected">What did you expect to happen?</label>
            <textarea
              id="fb-expected"
              name="expected"
              maxlength={LIMITS.detail}
              rows="3"
            ></textarea>
          </div>
          <div class="field">
            <label for="fb-actual">What actually happened?</label>
            <textarea id="fb-actual" name="actual" maxlength={LIMITS.detail} rows="3"></textarea>
          </div>
          <div class="field">
            <label for="fb-steps">Steps to reproduce</label>
            <textarea id="fb-steps" name="steps" maxlength={LIMITS.detail} rows="4"></textarea>
          </div>
        </fieldset>

        <div class="fbform__two">
          <div class="field">
            <label for="fb-name">
              Display name <span class="hint">(optional)</span>
            </label>
            <input
              id="fb-name"
              name="displayName"
              type="text"
              maxlength={LIMITS.name}
              autocomplete="nickname"
            />
            <label class="check">
              <input type="checkbox" name="anonymous" value="1" /> Post as Anonymous
            </label>
          </div>
          <div class="field">
            <label for="fb-email">
              Reply email <span class="hint">(optional, private)</span>
            </label>
            <input
              id="fb-email"
              name="email"
              type="email"
              maxlength={LIMITS.email}
              autocomplete="email"
              aria-describedby="fb-email-hint"
            />
            <p class="hint" id="fb-email-hint">
              Only Travis sees this, and only to reply to you. It's never shown publicly.
            </p>
          </div>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="fb-website">Leave this empty</label>
          <input id="fb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn btn--primary" type="submit" data-submit>
          Send feedback
        </button>
        <p class="hint">
          By sending, you agree to the <a href="/community-guidelines">community guidelines</a>.{' '}
          <a href="/privacy">Privacy</a> explains what's stored and for how long.
        </p>
      </form>

      <div
        class="fbreceipt panel panel--accent"
        tabindex="-1"
        hidden
        data-receipt
        aria-live="polite"
      ></div>
    </div>

    <aside class="fb__aside">
      <FeedbackList heading="Recently approved" />
    </aside>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-feedback-form]');
  if (form) {
    const bug = form.querySelector<HTMLElement>('[data-bug-fields]')!;
    const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
    const receipt = document.querySelector<HTMLElement>('[data-receipt]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const params = new URLSearchParams(location.search);

    // Prefill from links like /feedback?type=bug&project=retrotv&subject=...
    const type = params.get('type');
    if (type)
      form
        .querySelector<HTMLInputElement>(`input[name="type"][value="${CSS.escape(type)}"]`)
        ?.click();
    const project = params.get('project');
    const sel = form.querySelector<HTMLSelectElement>('#fb-project')!;
    if (project && [...sel.options].some((o) => o.value === project)) sel.value = project;
    const subject = params.get('subject');
    if (subject) form.querySelector<HTMLInputElement>('#fb-title')!.value = subject.slice(0, 120);

    // Bug fields only show for bug reports when JavaScript is available.
    const syncBug = () => {
      const t = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value;
      bug.hidden = t !== 'bug';
    };
    form
      .querySelectorAll('input[name="type"]')
      .forEach((r) => r.addEventListener('change', syncBug));
    syncBug();

    const clearErrors = () => {
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll('.error-text').forEach((el) => el.remove());
      summary.hidden = true;
    };
    const showErrors = (errors: Record<string, string>) => {
      const items: string[] = [];
      for (const [name, msg] of Object.entries(errors)) {
        const field = form.querySelector<HTMLElement>(`[name="${CSS.escape(name)}"]`);
        if (field) {
          field.setAttribute('aria-invalid', 'true');
          const p = document.createElement('p');
          p.className = 'error-text';
          p.id = `err-${name}`;
          p.textContent = msg;
          field.insertAdjacentElement('afterend', p);
          field.setAttribute(
            'aria-describedby',
            `${field.getAttribute('aria-describedby') ?? ''} err-${name}`.trim(),
          );
        }
        items.push(msg);
      }
      summary.replaceChildren();
      const h = document.createElement('p');
      h.innerHTML = '<strong>Please fix the following:</strong>';
      const ul = document.createElement('ul');
      for (const m of items) {
        const li = document.createElement('li');
        li.textContent = m;
        ul.append(li);
      }
      summary.append(h, ul);
      summary.hidden = false;
      summary.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();
      const msg = form.querySelector<HTMLTextAreaElement>('#fb-message')!;
      const email = form.querySelector<HTMLInputElement>('#fb-email')!;
      const local: Record<string, string> = {};
      if (msg.value.trim().length < Number(msg.minLength))
        local.message = `Write at least ${msg.minLength} characters in the message.`;
      if (email.value && !email.checkValidity())
        local.email = 'Enter a valid email address, or leave it empty.';
      if (Object.keys(local).length) return showErrors(local);

      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { accept: 'application/json' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          form.hidden = true;
          receipt.replaceChildren();
          const h = document.createElement('h2');
          h.textContent =
            data.visibility === 'private'
              ? 'Private report received'
              : 'Received: waiting for review';
          const p = document.createElement('p');
          p.textContent =
            data.visibility === 'private'
              ? 'Thanks. Your report is stored privately. Only Travis can see it, and it will never be published.'
              : "Thanks. Your feedback is stored and pending review. It isn't public yet, and it only appears on the site if it's approved.";
          const ref = document.createElement('p');
          ref.className = 'mono hint';
          ref.textContent = `Reference: ${data.id}`;
          const again = document.createElement('a');
          again.href = '/feedback';
          again.textContent = 'Send something else';
          receipt.append(h, p, ref, again);
          receipt.hidden = false;
          receipt.focus();
        } else if (res.status === 400 && data.errors) {
          showErrors(data.errors);
        } else {
          showErrors({
            form:
              data.error ??
              "Your feedback couldn't be sent. Nothing was stored. Please try again later.",
          });
        }
      } catch {
        showErrors({
          form: "Your feedback couldn't be sent because the connection failed. Nothing was stored. Your text is still in the form.",
        });
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send feedback';
      }
    });
  }
</script>

<style>
  .fb {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-7);
  }
  @media (max-width: 60rem) {
    .fb {
      grid-template-columns: 1fr;
    }
  }
  .fbform {
    margin-top: var(--space-5);
  }
  .fbform__two {
    display: grid;
    gap: 0 var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .radio-row--stack {
    flex-direction: column;
  }
  .fbform__summary {
    border: 2px solid var(--bad);
    border-radius: var(--radius-s);
    padding: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .fbreceipt {
    margin-top: var(--space-5);
  }
</style>

---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  accent?: string;
  noindex?: boolean;
  ogImage?: string;
  current?: string;
}

const { title, description, accent, noindex = false, ogImage, current = '' } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const fullTitle = title === 'Home' ? 'Travis Dater · Signal Workshop' : `${title} · Travis Dater`;
const ogUrl = site && ogImage ? new URL(ogImage, site).href : undefined;

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/guides', label: 'Guides' },
  { href: '/faq', label: 'FAQ' },
  { href: '/downloads', label: 'Downloads' },
  { href: '/about', label: 'About' },
  { href: '/feedback', label: 'Feedback' },
];
const style = accent ? `--accent:${accent}` : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="theme-color" content="#07080b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Progressive enhancement flag and the saved glow preference. Storage can be unavailable
      // (private mode, blocked site data), so every access is guarded.
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('sw-glow') === 'low')
          document.documentElement.dataset.glow = 'low';
      } catch (e) {}
    </script>
  </head>
  <body style={style}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap site-header__bar">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28">
              <path
                d="M2 20h6l3-10 5 16 4-12 2 6h8"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
          <span class="brand__name">Travis Dater</span>{' '}
          <span class="brand__sub">signal workshop</span>
        </a>
        <button
          class="nav-toggle btn btn--small"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          hidden
        >
          Menu
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
          <form class="nav-search" action="/search" method="get" role="search">
            <label class="visually-hidden" for="nav-q">
              Search the workshop
            </label>
            <input id="nav-q" name="q" type="search" placeholder="Search projects, guides, FAQ" />
            <button class="btn btn--small" type="submit">
              Search
            </button>
          </form>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <p class="site-footer__name">Travis Dater · Signal Workshop</p>
          <p class="hint">
            Personal projects, shared as-is. No trackers, no analytics, no cookies for visitors.
          </p>
        </div>
        <ul class="site-footer__links">
          <li>
            <a href="/privacy">Privacy</a>
          </li>
          <li>
            <a href="/community-guidelines">Community guidelines</a>
          </li>
          <li>
            <a href="/search">Search</a>
          </li>
          <li>
            <a href="/feedback">Send feedback</a>
          </li>
        </ul>
        <div>
          <button class="btn btn--small glow-toggle" type="button" aria-pressed="false" hidden>
            Low-glow reading mode
          </button>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('is-open')) {
            nav.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
      }
      const glow = document.querySelector<HTMLButtonElement>('.glow-toggle');
      if (glow) {
        glow.hidden = false;
        const root = document.documentElement;
        const sync = () => glow.setAttribute('aria-pressed', String(root.dataset.glow === 'low'));
        sync();
        glow.addEventListener('click', () => {
          const low = root.dataset.glow !== 'low';
          if (low) root.dataset.glow = 'low';
          else delete root.dataset.glow;
          try {
            localStorage.setItem('sw-glow', low ? 'low' : 'normal');
          } catch {
            /* preference just won't persist */
          }
          sync();
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    min-height: var(--target);
    margin-right: auto;
  }
  .brand__mark {
    color: var(--signal);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--signal) 50%, transparent));
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .brand__sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-2);
    border-left: 1px solid var(--line-strong);
    padding-left: var(--space-2);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    text-decoration: none;
    color: var(--text-2);
    border-radius: var(--radius-s);
  }
  .site-nav a:hover {
    color: var(--text);
  }
  .site-nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--signal);
  }
  .nav-search {
    display: flex;
    gap: var(--space-2);
  }
  .nav-search input {
    width: 15rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.6rem;
  }

  @media (max-width: 68rem) {
    .nav-search input {
      width: 11rem;
    }
  }
  /* With JS the nav collapses behind a button on narrow screens; without JS it simply wraps. */
  @media (max-width: 60rem) {
    :global(.js) .site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      padding-bottom: var(--space-4);
    }
    :global(.js) .site-nav.is-open {
      display: flex;
    }
    :global(.js) .site-nav ul {
      flex-direction: column;
    }
    .nav-search {
      width: 100%;
    }
    .nav-search input {
      width: 100%;
      flex: 1;
    }
    .brand__sub {
      display: none;
    }
  }
  .nav-toggle {
    min-height: var(--target);
  }
  @media (min-width: 60.01rem) {
    .nav-toggle {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface-1);
    padding-block: var(--space-6);
    margin-top: var(--space-7);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    align-items: start;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }
  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer__links a {
    display: inline-flex;
    min-height: var(--target);
    align-items: center;
    color: var(--text-2);
  }
  main:focus {
    outline: none;
  }
</style>

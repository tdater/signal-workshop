---
// Approved public feedback, fetched from the feedback API. Only items the owner approved are
// ever returned by the server; this component just displays them as plain text.
interface Props {
  project?: string;
  heading?: string;
}
const { project = '', heading = 'Approved comments' } = Astro.props;
---

<div class="flist" data-feedback-list data-project={project}>
  <h3 class="flist__title">{heading}</h3>
  <p class="hint" data-state>
    Comments appear here after review.
  </p>
  <noscript>
    <p class="hint">Turn on JavaScript to load approved comments.</p>
  </noscript>
  <ol class="flist__items" data-items></ol>
  <div class="meta-row" data-pager hidden>
    <button type="button" class="btn btn--small" data-prev>
      Newer
    </button>
    <span class="mono hint" data-page></span>
    <button type="button" class="btn btn--small" data-next>
      Older
    </button>
  </div>
</div>

<script>
  const typeLabel: Record<string, string> = {
    comment: 'Comment',
    suggestion: 'Suggestion',
    idea: 'Idea',
    bug: 'Bug report',
    question: 'Question',
  };
  type Item = {
    id: string;
    type: string;
    project: string;
    title: string | null;
    message: string;
    displayName: string | null;
    createdAt: string;
    reply: string | null;
  };
  for (const root of document.querySelectorAll<HTMLElement>('[data-feedback-list]')) {
    const state = root.querySelector<HTMLElement>('[data-state]')!;
    const list = root.querySelector<HTMLOListElement>('[data-items]')!;
    const pager = root.querySelector<HTMLElement>('[data-pager]')!;
    const pageLabel = root.querySelector<HTMLElement>('[data-page]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let page = 1;
    const load = async () => {
      state.textContent = 'Loading approved comments…';
      state.hidden = false;
      try {
        const qs = new URLSearchParams({ page: String(page) });
        if (root.dataset.project) qs.set('project', root.dataset.project);
        const res = await fetch(`/api/feedback?${qs}`, { headers: { accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        const data: { items: Item[]; page: number; pages: number } = await res.json();
        list.replaceChildren();
        if (!data.items.length) {
          state.textContent =
            page === 1 ? 'No approved comments yet. Be the first, politely.' : 'No more comments.';
        } else {
          state.hidden = true;
          for (const it of data.items) {
            const li = document.createElement('li');
            li.className = 'flist__item';
            const head = document.createElement('p');
            head.className = 'flist__meta mono';
            head.textContent = `${typeLabel[it.type] ?? it.type} · ${it.displayName || 'Anonymous'} · ${new Date(it.createdAt).toLocaleDateString()}`;
            li.append(head);
            if (it.title) {
              const t = document.createElement('p');
              t.className = 'flist__ttl';
              t.textContent = it.title;
              li.append(t);
            }
            const body = document.createElement('p');
            body.className = 'flist__msg';
            body.textContent = it.message;
            li.append(body);
            if (it.reply) {
              const r = document.createElement('p');
              r.className = 'flist__reply';
              r.textContent = `Travis replied: ${it.reply}`;
              li.append(r);
            }
            list.append(li);
          }
        }
        pager.hidden = data.pages <= 1;
        pageLabel.textContent = `Page ${data.page} of ${Math.max(1, data.pages)}`;
        prev.disabled = data.page <= 1;
        next.disabled = data.page >= data.pages;
      } catch {
        state.textContent =
          "Comments couldn't be loaded right now. The feedback service may be unavailable. The rest of this page works fine.";
      }
    };
    prev.addEventListener('click', () => {
      page = Math.max(1, page - 1);
      load();
    });
    next.addEventListener('click', () => {
      page += 1;
      load();
    });
    load();
  }
</script>

<style>
  .flist {
    margin-top: var(--space-5);
  }
  .flist__items {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .flist :global(.flist__item) {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-4);
  }
  .flist :global(.flist__meta) {
    font-size: 0.8rem;
    color: var(--text-2);
    margin-bottom: var(--space-2);
  }
  .flist :global(.flist__ttl) {
    font-weight: 700;
    margin-bottom: var(--space-1);
  }
  .flist :global(.flist__msg) {
    white-space: pre-wrap;
    margin: 0;
  }
  .flist :global(.flist__reply) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
    color: var(--text-2);
    white-space: pre-wrap;
  }
</style>

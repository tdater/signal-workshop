{
  "name": "signal-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Travis Dater's personal project site: static Astro pages plus a small Cloudflare Pages Functions feedback backend.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-projects.mjs && astro build && node scripts/postbuild-check.mjs",
    "preview": "wrangler pages dev dist --port 8788",
    "check": "astro check && tsc -p tsconfig.functions.json --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply signal-workshop --local",
    "db:migrate:remote": "wrangler d1 migrations apply signal-workshop --remote",
    "admin:hash": "node scripts/hash-password.mjs",
    "verify:downloads": "node scripts/verify-downloads.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.56.1",
    "astro": "7.3.8",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "qrcode-generator": "^2.0.4"
  }
}
